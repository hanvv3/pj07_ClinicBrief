# Copy to .env.local and set your existing key locally. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional cloud tracing. Local records work without these settings.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# New agent-based workspace: set both values, with no LANGSMITH_PROJECT.
# LANGSMITH_AGENT_ID=your-agent-id
# LANGSMITH_AGENT_ENVIRONMENT=local
# Project-based workspace: use this instead of the two agent fields.
# LANGSMITH_PROJECT=clinic-brief-research
# Set the endpoint for your workspace's region when it is not the US default.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
